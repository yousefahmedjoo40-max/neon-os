#!/bin/bash
# NeonOS: هوية النظام، إعدادات الدوك، وإخفاء الواجهات التقنية
set -e

# نسخة افتراضية من إعدادات سطح المكتب (تُستخدم لإصلاحها بتحديث لاحقاً)
mkdir -p /usr/share/novaos/defaults/config
cp -a /etc/skel/.config/. /usr/share/novaos/defaults/config/ 2>/dev/null || true
rm -rf /usr/share/novaos/defaults/config/neonos /usr/share/novaos/defaults/config/autostart

# أيقونات Neon
gtk-update-icon-cache -f /usr/share/icons/Neon 2>/dev/null || true

# أداء أفضل على الأجهزة الضعيفة: zram + swappiness
echo "vm.swappiness=20" > /etc/sysctl.d/99-neon.conf
if [[ -f /etc/default/zramswap ]]; then sed -i 's/^#\?PERCENT=.*/PERCENT=60/' /etc/default/zramswap || true; fi

# اسم النظام
if [[ -f /etc/os-release ]]; then
  sed -i 's/^NAME=.*/NAME="NeonOS"/; s/^PRETTY_NAME=.*/PRETTY_NAME="NeonOS 1.0"/; s/^VERSION=.*/VERSION="1.0"/' /etc/os-release || true
fi
printf 'NeonOS 1.0 \\n \\l\n\n' > /etc/issue
echo "NeonOS 1.0" > /etc/issue.net

# إخفاء الأدوات التقنية من القوائم (تظل تعمل عبر الطرفية)
for f in debian-xterm debian-uxterm xterm uxterm vim gvim htop lstopo bvnc bssh avahi-discover xfce4-about; do
  F="/usr/share/applications/$f.desktop"
  if [[ -f "$F" ]]; then
    sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$F" || true
  fi
done

chmod +x /opt/novaos/neon/*.sh /opt/novaos/neon/*.py 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
update-desktop-database 2>/dev/null || true

echo "[hook] واجهة NeonOS جاهزة."
